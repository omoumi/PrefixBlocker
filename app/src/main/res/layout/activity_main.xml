<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />
        <LinearLayout style="@style/Card">
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/enableButton"
                style="@style/PillButton"
                android:layout_marginTop="12dp"
                android:text="@string/enable" />
        </LinearLayout>
        <LinearLayout
            style="@style/Card"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/switch_title" />
                <TextView
                    style="@style/SubText"
                    android:text="@string/switch_sub" />
            </LinearLayout>
            <Switch
                android:id="@+id/blockSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <LinearLayout style="@style/Card">
            <TextView
                style="@style/SectionTitle"
                android:text="@string/prefixes_title" />
            <TextView
                style="@style/SubText"
                android:text="@string/prefixes_sub" />
            <EditText
                android:id="@+id/prefixInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/field_bg"
                android:gravity="top"
                android:hint="@string/hint_example"
                android:inputType="phone|textMultiLine"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/text"
                android:textColorHint="@color/subtext"
                android:textSize="18sp" />
            <Button
                android:id="@+id/saveButton"
                style="@style/PillButton"
                android:layout_marginTop="12dp"
                android:text="@string/save" />
        </LinearLayout>
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/history_title" />
                <TextView
                    android:id="@+id/historyCount"
                    style="@style/SubText" />
            </LinearLayout>
            <TextView
                android:id="@+id/historyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="14sp" />
            <Button
                android:id="@+id/clearButton"
                style="@style/TextButton"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/clear_history" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
